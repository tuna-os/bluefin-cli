root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[*.{sh,bash}]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4

[{Containerfile,Dockerfile}*]
indent_style = space
indent_size = 4

[{justfile,Justfile}]
indent_style = space
indent_size = 2

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
